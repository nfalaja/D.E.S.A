  m_Script: {fileID: 11500000, guid: 80805cf8a2a4c8f48894ade70ffa8eba, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CutsceneManager
  dialogText: {fileID: 220817750}
  namaPembicaraText: {fileID: 441806942}
  wadahDialog: {fileID: 1631521113}
  cutsceneSequence:
  - gambarCutscene: {fileID: 1358946322}
    namaPembicara: Kepala Desa Tua
    teksDialog: Selamat, Nak. Mulai hari ini, kamu resmi saya tunjuk untuk memimpin
      program pembangunan di desa kita. Ini Surat Jabatannya
  - gambarCutscene: {fileID: 1358946322}
    namaPembicara: Kepala Desa Muda
    teksDialog: Terima kasih banyak atas kepercayaannya, Pak! Saya berjanji akan
      mengemban amanah ini dengan penuh tanggung jawab demi kemajuan desa kita
  - gambarCutscene: {fileID: 754575651}
    namaPembicara: Kepala Desa Tua
    teksDialog: Nah, ini draf awal Program Desa Mandiri yang sudah saya siapkan.
      Pelajari baik-baik agar kamu punya gambaran untuk langkah pertama
  - gambarCutscene: {fileID: 754575651}
    namaPembicara: Kepala Desa Muda
    teksDialog: Baik, Pak, saya pahami. Dokumen ini akan menjadi acuan penting bagi
      saya saat turun ke lapangan nant
  - gambarCutscene: {fileID: 1987910246}
    namaPembicara: Kepala Desa Muda
    teksDialog: Berdasarkan rencana di kertas ini, area persawahan di sebelah utara
      desa memang yang paling membutuhkan sistem irigasi baru secepatnya
  - gambarCutscene: {fileID: 1987910246}
    namaPembicara: Petani
    teksDialog: Semoga rencana pembangunan saluran airnya berjalan lancar ya, Mas.
      Kami para petani sangat mengandalkannya
  - gambarCutscene: {fileID: 1977190132}
    namaPembicara: Kepala Desa Muda
    teksDialog: Luar biasa! Progres pengerjaan jalurnya sangat cepat dan semua material
      sudah siap. Pertahankan kerja bagus ini, Pak!
  - gambarCutscene: {fileID: 1977190132}
    namaPembicara: Pekerja
    teksDialog: Siap, Pak! Kami semua bersemangat karena tahu fasilitas ini akan
      sangat berguna untuk seluruh warga desa
